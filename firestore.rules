rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ramayaroyalventuresltd@gmail.com' ||
        request.auth.token.email == 'freelander@fcta.gov.ng' ||
        request.auth.token.email == 'system@fcta.gov.ng' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Questions collection (unlimited CBT question bank)
    match /questions/{questionId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Exam attempts
    match /attempts/{attemptId} {
      allow read, write: if true;
    }

    // User progress across 4 sets & cycles
    match /progress/{userId} {
      allow read, write: if true;
    }
  }
}
